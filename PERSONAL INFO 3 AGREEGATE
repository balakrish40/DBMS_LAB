-- EMP table and HAVING clause
CREATE TABLE emp (
    eid INT PRIMARY KEY,
    ename VARCHAR(20),
    age INT,
    edu VARCHAR(10)
);
INSERT INTO emp VALUES
(1, 'sindhu', 25, 'mca'),
(2, 'kavi', 26, 'mca'),
(3, 'rithu', 25, 'mca'),
(4, 'raju', 26, 'mca'),
(5, 'ganesh', 25, 'mca'),
(6, 'priya', 26, 'mca');
SELECT * FROM emp;
SELECT edu, COUNT(eid) AS num_employees FROM emp GROUP BY edu HAVING COUNT(eid) > 3;
SELECT age, COUNT(eid) AS num_employees FROM emp GROUP BY age HAVING COUNT(eid) >= 3;
