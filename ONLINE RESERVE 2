-- Table 3: Reservation
CREATE TABLE reserve (
    r_id INT PRIMARY KEY,
    c_id INT,
    vid INT,
    start_datetime DATETIME CHECK (start_datetime >= '2025-10-25'),
    end_datetime DATETIME,
    place VARCHAR(15),
    FOREIGN KEY (c_id) REFERENCES customer(c_id),
    FOREIGN KEY (vid) REFERENCES vehicle(vid)
);

