-- Foreign key creation
CREATE TABLE loandetails (
    loanid INT PRIMARY KEY,
    accno INT,
    loanamt INT,
    FOREIGN KEY (accno) REFERENCES bank(accno)
);

DESC loandetails;
INSERT INTO loandetails VALUES (101, 17071, 50000);
INSERT INTO loandetails VALUES (102, 17074, 60000);
-- The following row is shown as a foreign-key error in the record because accno 17077 does not exist.
INSERT INTO loandetails VALUES (103, 17077, 45000);
SELECT * FROM loandetails;

-- Join two tables
SELECT b.cust_name, l.loanid, l.loanamt
FROM bank b INNER JOIN loandetails l ON b.accno = l.accno;


