-- Program 4: Student Mark Processing System
CREATE TABLE studentdata (
    rollno VARCHAR(8) PRIMARY KEY,
    studentname VARCHAR(15),
    java INT,
    adbms INT,
    cn INT,
    os INT,
    d_net INT,
    total INT,
    percentage INT
);

