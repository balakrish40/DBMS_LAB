-- Update total and percentage columns
UPDATE studentdata SET total = java + adbms + cn + os + d_net;
UPDATE studentdata SET percentage = total / 5;
SELECT * FROM studentdata;

-- Logical operators using WHERE clause
SELECT rollno, java FROM studentdata WHERE java BETWEEN 45 AND 65;
SELECT rollno, java, d_net FROM studentdata WHERE java > 45 AND d_net > 45;
SELECT rollno, cn, os FROM studentdata WHERE cn >= 60 OR os >= 60;
SELECT rollno, studentname FROM studentdata WHERE total NOT BETWEEN 300 AND 350;
SELECT rollno, studentname FROM studentdata WHERE total <> 302;
SELECT rollno, studentname, total FROM studentdata WHERE total = 299;
